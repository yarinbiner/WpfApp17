<Window x:Class="WpfApp17.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp17"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/pics/eyalgolanhamelech.png"/>


        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="4*"/>

        </Grid.RowDefinitions>
        <TextBlock Text="Best Vacations At Biners" Grid.Row="0" FontSize="40" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Foreground="Navy" Margin="0,20,368,0" Background="White"/>
        <ComboBox Grid.Row="1"
          Width="200"
          Height="30"
          VerticalAlignment="Top"
          HorizontalAlignment="Right"
          Margin="0,48,31,0">
            <!--הגדרת קומבו בוקס-->
            <!--אופציות בתוך הקומבו בוקס -->
            <ComboBoxItem Content="ISRAEL" FontWeight="Bold"/>
            <ComboBoxItem Content="USA" FontWeight="Bold"/>
            <ComboBoxItem Content="HUNGARY" FontWeight="Bold"/>
            <ComboBoxItem Content="SPAIN" FontWeight="Bold"/>
        </ComboBox>
        <!--טקסטים-->
        <TextBlock Text="CHOOSE A COUNTRY" Background="White"  Grid.Row="1"
        HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="25" Margin="0,6,20,0"/>
        <TextBlock Text="CHOOSE AN AREA" Background="White" Grid.Row="1"
HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="25" Margin="300,6,0,0"/>
        <TextBlock Text="CHOOSE AN HOTEL" Background="White" Grid.Row="1"
HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="25" Margin="0,6,555,0"/>
        <ComboBox Grid.Row="1"
Width="200"
Height="30"
VerticalAlignment="Top"
HorizontalAlignment="Left"
Margin="33,48,0,0"
 x:Name="hotelBox">
            <!--הגדרת קומבו בוקס-->
            <!--אופציות בתוך הקומבו בוקס -->
            <ComboBoxItem Content="MARRIOT" FontWeight="Bold" x:Name="marriot"/>
            <ComboBoxItem Content="HILTON" FontWeight="Bold" x:Name="hilton"/>
            <ComboBoxItem Content="HYATT" FontWeight="Bold" x:Name="hyatt"/>
        </ComboBox>

        <ComboBox Grid.Row="1"
  Width="200"
  Height="30"
  VerticalAlignment="Top"
  HorizontalAlignment="Left"
  Margin="302,48,0,0">
            <!--הגדרת קומבו בוקס-->
            <!--אופציות בתוך הקומבו בוקס -->
            <ComboBoxItem Content="NORTH" FontWeight="Bold"/>
            <ComboBoxItem Content="SOUTH" FontWeight="Bold"/>
            <ComboBoxItem Content="CENTER" FontWeight="Bold"/>
        </ComboBox>
        <Button Click="Chosing_Leaving_Date" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="437,153,0,0" Grid.Row="1" Width="300" Height="30" >
            <TextBlock Grid.Row="1" Text=" CHOOSE LEAVING DATE" FontSize="25" Margin="0,-5,0,0" Foreground="Black"/>
        </Button>
        <Calendar x:Name="leavingCal"
          Grid.Row="1"
          Width="200"
          Margin="408,184,192,-184"
          SelectionMode="SingleDate"
          Visibility="Collapsed"
          Panel.ZIndex="100"
          SelectedDatesChanged="LeavingCal_SelectedDatesChanged"/>

        <Calendar x:Name="arrivingCal"
          Grid.Row="1"
          Width="200"
          Margin="150,184,446,-25"
          SelectionMode="SingleDate"
          Visibility="Collapsed"
          Panel.ZIndex="100"
          SelectedDatesChanged="ArrivingCal_SelectedDatesChanged"/>
        <Button Click="Chosing_Arrival_Date" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,153,0,0" Grid.Row="1" Width="300" Height="30" >
            <TextBlock Grid.Row="1" Text=" CHOOSE ARRIVAL DATE" FontSize="25" Margin="0,-5,0,0" Foreground="Black"/>
        </Button>
        <TextBlock x:Name="nightsNum"  Grid.Row="1" Text="NIGHTS: 0" FontSize="25" Margin="10,188,-10,-88" Foreground="Black"/>
        <TextBlock x:Name="price" Grid.Row="1" Text="PRICE: 0" FontSize="25" Margin="10,219,-10,-57" Foreground="Black"/>
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Label Content="SELECT A ROOM" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,184,3,0"
               Background="White" FontWeight="Bold" Height="39" Width="116" />
            <RadioButton Content="Single" Checked="Selected" GroupName="rooms" 
             Background="White"/>
            <RadioButton Checked="Selected" Content="Double" GroupName="rooms" 
             Background="White"/>
            <RadioButton Checked="Selected" Content="Triple" GroupName="rooms" 
             Background="White"/>
            <RadioButton Checked="Selected" Content="Family" GroupName="rooms"
             Background="White"/>
        </StackPanel>

    </Grid>
</Window>
